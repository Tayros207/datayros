{
  "redirects": [
    { "source": "/docs/:path*",              "destination": "/", "permanent": false },
    { "source": "/preview/:path*",           "destination": "/", "permanent": false },
    { "source": "/knowledge/:path*",         "destination": "/", "permanent": false },
    { "source": "/6-8-26tairos_landing.html","destination": "/", "permanent": true  },
    { "source": "/README.md",                "destination": "/", "permanent": true  },
    { "source": "/img/README.md",            "destination": "/", "permanent": true  }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",     "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
